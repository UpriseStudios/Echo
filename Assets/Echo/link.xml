<!--
  IL2CPP code stripping guard (device testing: the real services never started on a phone). Unity Services, IAP
  and LevelPlay find parts of themselves by reflection, and saves are read with Newtonsoft JSON by reflection,
  so keep those assemblies and our own whole.
-->
<linker>
  <assembly fullname="Echo.Core" preserve="all" />
  <assembly fullname="Echo.Game" preserve="all" />
  <assembly fullname="Echo.Services" preserve="all" />
  <assembly fullname="Newtonsoft.Json" preserve="all" />
  <assembly fullname="Unity.Services.Core" preserve="all" />
  <assembly fullname="Unity.Services.Core.Internal" preserve="all" />
  <assembly fullname="Unity.Services.Core.Configuration" preserve="all" />
  <assembly fullname="Unity.Services.Core.Registration" preserve="all" />
  <assembly fullname="Unity.Services.Core.Scheduler" preserve="all" />
  <assembly fullname="Unity.Services.Core.Telemetry" preserve="all" />
  <assembly fullname="Unity.Services.Core.Threading" preserve="all" />
  <assembly fullname="Unity.Services.Core.Environments" preserve="all" />
  <assembly fullname="Unity.Services.Analytics" preserve="all" />
  <assembly fullname="Unity.LevelPlay" preserve="all" />
  <assembly fullname="Unity.Purchasing" preserve="all" />
</linker>
